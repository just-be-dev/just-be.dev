---
import { getCollection, render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Tag from "@/components/Tag.astro";
import Link from "@/components/Link.astro";
import BackLink from "@/components/BackLink.astro";
import MDContent from "@/components/MDContent.astro";
import Layout from "@/layouts/Layout.astro";
import { Code } from "@/utils/code";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];

const post = Astro.props;
const { Content } = await render(post);

// Get code from frontmatter, fallback to parsing filename for backwards compatibility
const code = post.data.code ? post.data.code.toUpperCase() : Code.fromId(post.id).toString();
---

<Layout title={`${post.data.title} - Just Be`} description={post.data.description}>
  <article class="px-2 md:px-4 max-w-article mx-auto">
    <header class="mb-2lh grid grid-cols-1 md:grid-cols-[1fr_auto] gap-x-2 not-prose">
      <h1 class="mb-0 font-bold">{post.data.title}</h1>

      <div class="flex justify-between items-center gap-2">
        <div class="flex gap-[1ch]">
          <span class="text-fg-2">{code}</span>
          <span class="opacity-25">|</span>
          <FormattedDate date={post.data.date} />
        </div>

        {
          post.data.tags.length > 0 && (
            <div class="tag-preview relative flex justify-end">
              <button
                type="button"
                class="text-fg-2 flex items-center gap-[0.5ch] text-sm cursor-pointer bg-transparent border-none p-0"
                aria-label="Show tags"
              >
                <div class="i-pixel-tag" />
                <span>{post.data.tags.length}</span>
              </button>
              <div class="tag-list hidden absolute right-0 top-full pt-1 z-10">
                <div class="flex flex-wrap gap-2 bg-1 px-2 py-1">
                  {post.data.tags.map((tag) => (
                    <Tag tag={tag} url="/blog" />
                  ))}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </header>

    <div class="max-w-none">
      <MDContent Content={Content} components={{ a: Link }} />
    </div>

    <BackLink href="/blog" label="Back to blog" />
  </article>
</Layout>

<style>
  .tag-preview:hover .tag-list,
  .tag-preview:focus-within .tag-list,
  .tag-list:hover {
    display: block;
  }
</style>
