---
import { getCollection } from "astro:content";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils/date";

export const prerender = false;

// Get selected tag from query params
const selectedTag = Astro.url.searchParams.get("tag");

// Get all blog posts
let allPosts = await getCollection("blog", ({ data }) => !data.draft);
allPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Filter posts if tag is selected
const posts = selectedTag
  ? allPosts.filter((post) => post.data.tags.includes(selectedTag))
  : allPosts;

// Calculate tag counts from all posts
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag));
---

<Layout title="Blog - Just Be">
  <header class="mb-2 flex justify-between">
    <h1 class="font-bold">~/blog</h1>
    <div class="flex flex-wrap items-center gap-2">
      {
        selectedTag ? (
          <>
            <Tag
              tag={selectedTag}
              count={tagCounts.get(selectedTag)}
              url="/blog"
              class="invert"
              id="selected-tag"
            />
            <Button shortcut="c" label="clear" href="/blog" />
          </>
        ) : (
          sortedTags.map(({ tag, count }) => <Tag tag={tag} count={count} url="/blog" />)
        )
      }
    </div>
  </header>

  <ul class="grid grid-cols-[auto_auto_1fr] gap-x-4">
    {
      posts.map((post) => (
        <li class="contents before:content-none">
          <a
            href={`/blog/${post.id}/`}
            class="bg-0 hocus:invert group col-span-3 -mx-[1ch] grid grid-cols-subgrid px-[1ch] outline-none"
          >
            <span class="text-fg-2 group-hocus:text-accent">{formatDate(post.data.date)}</span>
            <h2 class="font-bold whitespace-nowrap">{post.data.title}</h2>
            {post.data.description && <span class="min-w-0 truncate">{post.data.description}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<script>
  // Focus selected tag on page load
  const selectedTag = document.getElementById("selected-tag");
  if (selectedTag) {
    selectedTag.focus();
  }
</script>
