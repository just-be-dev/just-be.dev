---
import { getCollection } from "astro:content";
import Tag from "@/components/Tag.astro";
import LinkList from "@/components/LinkList.astro";
import type { LinkListItem } from "@/components/LinkList.astro";
import Layout from "@/layouts/Layout.astro";
import { Code } from "@/utils/code";

const tagEntries = await getCollection("tags");
const tagDescriptions = new Map(tagEntries.map((t) => [t.id, t.data.description]));

export const prerender = false;

// Get selected tag from query params
const selectedTag = Astro.url.searchParams.get("tag");

// Get all blog posts
const publishedPosts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
)
  .map((post) => ({
    ...post,
    code: post.data.code ? post.data.code.toUpperCase() : Code.fromId(post.id).toString(),
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Filter posts if tag is selected
const posts = selectedTag
  ? publishedPosts.filter((post) => post.data.tags.includes(selectedTag))
  : publishedPosts;

// Calculate tag counts from all posts
const tagCounts = new Map<string, number>();
publishedPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag));

// Transform posts for LinkList
const linkListItems: LinkListItem[] = posts.map((post) => {
  const date = `${post.data.date.getFullYear()}-${String(post.data.date.getMonth() + 1).padStart(2, "0")}-${String(post.data.date.getDate()).padStart(2, "0")}`;
  return {
    code: post.code,
    slug: Code.buildUrl("blog", post.id),
    title: post.data.title,
    date,
  };
});
---

<Layout title="Blog - Just Be">
  <header class="relative mb-2 flex flex-wrap items-start gap-[1ch]">
    <h1 class="font-bold">~/blog</h1>
    <div class="tag-filter flex">
      <button
        type="button"
        class="text-fg-2 flex cursor-pointer items-center gap-[0.5ch] border-none bg-transparent p-0 text-sm"
        aria-label={selectedTag ? `Filter by tag: ${selectedTag}` : "Filter by tag"}
        title="Filter by tag"
      >
        <div class="i-pixel-tag" aria-hidden="true"></div>
        <span>{selectedTag ?? sortedTags.length}</span>
      </button>
      <div class="tag-list absolute left-0 top-full z-10 hidden pt-1">
        <div class="bg-1 flex max-w-full flex-wrap gap-0 p-1">
          {
            selectedTag && (
              <a
                href="/blog"
                class="text-accent hocus:bg-0 hocus:invert flex items-center border-2 border-fg-0 px-[1ch] font-medium outline-none"
              >
                clear
              </a>
            )
          }
          {
            sortedTags.map(({ tag, count }) => (
              <Tag
                tag={tag}
                count={count}
                url="/blog"
                class={selectedTag === tag ? "invert" : undefined}
                id={selectedTag === tag ? "selected-tag" : undefined}
                description={tagDescriptions.get(tag)}
              />
            ))
          }
        </div>
      </div>
    </div>
  </header>

  <LinkList items={linkListItems} columns={["code", "date", "title"]} variant="grid" gap="normal" />
</Layout>

<style>
  .tag-filter:hover .tag-list,
  .tag-filter:focus-within .tag-list,
  .tag-list:hover {
    display: block;
  }
</style>
