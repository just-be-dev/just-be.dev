---
import { getCollection, render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Layout from "@/layouts/Layout.astro";
import { Code } from "@/utils/code";

export async function getStaticPaths() {
  const research = await getCollection("research");
  return research.map((item) => {
    const { code, slug } = Code.parseId(item.id);
    return {
      params: { code, slug },
      props: item,
    };
  });
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];

const item = Astro.props;
const { Content } = await render(item);
---

<Layout title={`${item.data.title} - Just Be`} description={item.data.description}>
  <article class="px-4 py-8">
    <header class="border-fg-2 mb-8 border-b pb-4">
      <h1 class="mb-2 font-bold">{item.data.title}</h1>
      {item.data.description && <p class="text-fg-2 mb-4">{item.data.description}</p>}

      <div class="text-fg-2 flex flex-wrap items-center gap-4 text-sm">
        {
          item.data.date && (
            <div>
              <span>Published: </span>
              <FormattedDate date={item.data.date} />
            </div>
          )
        }
        {
          item.data.lastUpdated && (
            <div>
              <span>Updated: </span>
              <FormattedDate date={item.data.lastUpdated} />
            </div>
          )
        }
        {
          item.data.status && (
            <span class="badge" variant-={item.data.status === "published" ? "success" : "default"}>
              {item.data.status}
            </span>
          )
        }
      </div>

      {
        item.data.topics && item.data.topics.length > 0 && (
          <div class="mt-4 flex gap-2">
            {item.data.topics.map((topic) => (
              <span class="badge text-accent bg-2 px-[1ch]">{topic}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose prose-invert max-w-none">
      <Content />
    </div>

    <footer class="border-fg-2 mt-12 border-t pt-8">
      <a href="/research" class="text-fg-0 link font-bold focus-visible:outline-none">
        ← Back to research
      </a>
    </footer>
  </article>
</Layout>

<style>
  .link:hover,
  .link:focus {
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
    background-color: var(--background0);
    filter: invert(1);
  }
</style>
