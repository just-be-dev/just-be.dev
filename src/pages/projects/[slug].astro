---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props'];

const project = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} - Just Be`} description={project.data.description}>
	<article class="px-4 py-8">
		<header class="mb-8 border-b border-fg-2 pb-4">
			<h1 class="font-bold mb-2">{project.data.title}</h1>
			{
				project.data.description && <p class="text-fg-2 mb-4">{project.data.description}</p>
			}

			<div class="flex flex-wrap items-center gap-4">
				{
					project.data.status && (
						<span
							class="badge"
							variant-={project.data.status === 'active' ? 'success' : 'default'}
						>
							{project.data.status}
						</span>
					)
				}

				{
					project.data.technologies && project.data.technologies.length > 0 && (
						<div class="flex gap-2">
							{project.data.technologies.map((tech) => (
								<span class="badge text-accent bg-2 px-[1ch]">{tech}</span>
							))}
						</div>
					)
				}
			</div>

			{
				(project.data.url || project.data.repository) && (
					<div class="flex gap-4 mt-4">
						{project.data.url && (
							<a
								href={project.data.url}
								target="_blank"
								rel="noopener noreferrer"
								class="bg-2 text-accent px-[1ch] py-1 hocus:bg-0 hocus:invert"
							>
								Visit Project →
							</a>
						)}
						{project.data.repository && (
							<a
								href={project.data.repository}
								target="_blank"
								rel="noopener noreferrer"
								class="bg-2 text-fg-0 px-[1ch] py-1 hocus:bg-0 hocus:invert"
							>
								View Source
							</a>
						)}
					</div>
				)
			}
		</header>

		<div class="prose prose-invert max-w-none">
			<Content />
		</div>

		<footer class="mt-12 pt-8 border-t border-fg-2">
			<a href="/projects" class="text-fg-0 font-bold focus-visible:outline-none link">
				← Back to projects
			</a>
		</footer>
	</article>
</Layout>

<style>
	.link:hover,
	.link:focus {
		padding-left: 0.5rem;
		padding-right: 0.5rem;
		margin-left: -0.5rem;
		margin-right: -0.5rem;
		background-color: var(--background0);
		filter: invert(1);
	}
</style>
