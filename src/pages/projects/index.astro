---
import { getCollection } from "astro:content";
import LinkBox from "../../components/LinkBox.astro";
import Layout from "../../layouts/Layout.astro";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Projects - Just Be">
  <header>
    <h1 class="mb-4 font-bold">~/projects</h1>
  </header>

  {
    sortedProjects.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2">
        {sortedProjects.map((project) => (
          <LinkBox
            href={`/projects/${project.id}`}
            title={project.data.title}
            description={project.data.description}
          />
        ))}
      </div>
    ) : (
      <div class="text-fg-2 py-12 text-center">
        <p>No projects yet. Check back soon!</p>
      </div>
    )
  }
</Layout>
