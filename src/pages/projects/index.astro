---
import Layout from "@/layouts/Layout.astro";
import LinkList from "@/components/LinkList.astro";
import type { LinkListItem } from "@/components/LinkList.astro";
import { Code } from "@/utils/code";
import { listProjects } from "@/utils/projects";
import { loadProjects } from "@/utils/site-projects";

// Rendered per request: project state comes from Desk (see src/utils/site-projects.ts).
export const prerender = false;

const { deskAvailable, projects } = await loadProjects();

const linkListItems: LinkListItem[] = listProjects(projects).map((project) => ({
  code: project.code,
  slug: Code.buildUrl("projects", project.slug),
  title: project.title,
  status: project.state,
  experimental: project.experimental,
  description: project.description,
}));

Astro.response.headers.set(
  "Cache-Control",
  deskAvailable ? "public, max-age=60, stale-while-revalidate=600" : "no-store"
);
---

<Layout title="Projects - Just Be">
  <header class="mb-2">
    <h1 class="font-bold">~/projects</h1>
  </header>

  <LinkList
    items={linkListItems}
    columns={["code", "status", "title"]}
    variant="grid"
    gap="tight"
    statusType="project"
  />
</Layout>
