---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LinkBox from '../../components/LinkBox.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Projects - Just Be">
	<div class="px-4 py-12">
		<header class="mb-12">
			<h1 class="font-bold mb-4">~/projects</h1>
		</header>

		{
			sortedProjects.length > 0 ? (
				<div class="grid gap-6 md:grid-cols-2">
					{sortedProjects.map((project) => (
						<LinkBox
							href={`/projects/${project.id}`}
							title={project.data.title}
							description={project.data.description}
						/>
					))}
				</div>
			) : (
				<div class="text-center py-12 text-fg-2">
					<p>No projects yet. Check back soon!</p>
				</div>
			)
		}
	</div>
</Layout>
