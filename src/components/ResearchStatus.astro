---
interface Props {
  status: "proposed" | "active" | "dormant" | "abandoned" | "concluded";
}

const { status } = Astro.props;

const statusColors = {
  proposed: "bg-blue-500/20 text-blue-700 dark:text-blue-300",
  active: "bg-green-500/20 text-green-700 dark:text-green-300",
  dormant: "bg-yellow-500/20 text-yellow-700 dark:text-yellow-300",
  abandoned: "bg-red-500/20 text-red-700 dark:text-red-300",
  concluded: "bg-gray-500/20 text-gray-700 dark:text-gray-400",
};

const statusColor = statusColors[status] || "bg-1 text-fg-1";
---

<span class={`px-1 h-1lh inline-flex items-center ${statusColor}`}>
  {status}
</span>
