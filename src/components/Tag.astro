---
interface Props {
  id?: string;
  tag: string;
  count?: number;
  url?: string;
  class?: string;
}

const { id, tag, count, url = "/blog", class: className } = Astro.props;
const tagUrl = `${url}?tag=${encodeURIComponent(tag)}`;
---

<a
  id={id}
  href={tagUrl}
  class:list={[
    "bg-2 text-accent hocus:bg-0 hocus:invert group flex items-center outline-none",
    className,
  ]}
>
  <span class="px-[1ch]">{tag}</span>
  {
    count !== undefined && (
      <span class="text-fg-2 bg-1 group-hocus:bg-2 group-hocus:text-accent px-[1ch]">{count}</span>
    )
  }
</a>
