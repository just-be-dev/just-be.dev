---
import { resolveSlideImageUrl } from "@/utils/assets";

interface Slide {
  image: string;
  timestamp?: number | string; // Can be seconds or "MM:SS" format
}

interface Props {
  /**
   * Either a number of slides (will look for images 1.png through n.png)
   * or an array of slide objects with image paths and optional timestamps
   */
  slides: number | Slide[];
  /**
   * Base path for slide images (e.g., "/talks/codegen-in-rust")
   */
  basePath: string;
  /**
   * ID for the talk (used for namespacing)
   */
  talkId: string;
  /**
   * Whether to sync slides with audio playback (requires audioPlayerId)
   */
  syncWithAudio?: boolean;
  /**
   * ID of the audio player to sync with (e.g., "audio-player-codegen-rust")
   */
  audioPlayerId?: string;
}

const { slides, basePath, talkId, syncWithAudio = false, audioPlayerId } = Astro.props;

// Convert "MM:SS" timestamp to seconds
function parseTimestamp(timestamp: number | string | undefined): number | undefined {
  if (timestamp === undefined) return undefined;
  if (typeof timestamp === "number") return timestamp;

  // Parse "MM:SS" or "HH:MM:SS" format
  const parts = timestamp.split(":").map(Number);
  if (parts.length === 2) {
    // MM:SS
    return parts[0] * 60 + parts[1];
  } else if (parts.length === 3) {
    // HH:MM:SS
    return parts[0] * 3600 + parts[1] * 60 + parts[2];
  }
  return undefined;
}

// Normalize slides to array format
const slideList: Slide[] =
  typeof slides === "number"
    ? Array.from({ length: slides }, (_, i) => ({
        image: `codegen-${i + 1}.png`,
      }))
    : slides.map((slide) => ({
        ...slide,
        timestamp: parseTimestamp(slide.timestamp),
      }));

// Resolve image URLs with local-first fallback
// Priority: 1) Local file in /assets/, 2) R2 URL from manifest, 3) Fallback path
const resolvedSlides = await Promise.all(
  slideList.map(async (slide) => {
    const resolvedUrl = await resolveSlideImageUrl(basePath, slide.image);
    // Fallback: if not resolved, try /assets/{basePath} (should rarely happen)
    const normalizedBase = basePath.startsWith("/") ? basePath.slice(1) : basePath;
    return {
      ...slide,
      url: resolvedUrl ?? `/assets/${normalizedBase}/${slide.image}`,
    };
  })
);

const totalSlides = resolvedSlides.length;
const containerId = `talk-slides-${talkId}`;
---

<div id={containerId} class="talk-slides not-prose flex flex-col h-full min-h-0" tabindex="0">
  <div
    class="slide-container border-2 border-fg-2 relative flex-1 group cursor-pointer overflow-hidden min-h-0 flex items-center justify-center"
  >
    <img
      src={resolvedSlides[0].url}
      alt="Slide 1"
      class="slide-image max-w-full max-h-full w-auto h-auto block flex-shrink"
    />
    <div
      class="slide-nav-left absolute inset-y-0 left-0 right-1/2 flex items-center justify-start pl-[1ch] opacity-0 transition-opacity duration-200 pointer-events-auto z-100"
    >
      <div
        class="i-pixel-arrow-alt-circle-left-solid w-12 h-12 pointer-events-none"
        style="filter: drop-shadow(0 0 10px var(--background0));"
      >
      </div>
    </div>
    <div
      class="slide-nav-right absolute inset-y-0 left-1/2 right-0 flex items-center justify-end pr-[1ch] opacity-0 transition-opacity duration-200 pointer-events-auto z-100"
    >
      <div
        class="i-pixel-arrow-alt-circle-right-solid w-12 h-12 pointer-events-none"
        style="filter: drop-shadow(0 0 10px var(--background0));"
      >
      </div>
    </div>
  </div>
</div>

<script define:vars={{ containerId, resolvedSlides, totalSlides, syncWithAudio, audioPlayerId }}>
  const container = document.getElementById(containerId);
  if (!container) throw new Error(`Container ${containerId} not found`);

  const img = container.querySelector(".slide-image");
  const slideContainer = container.querySelector(".slide-container");
  const navLeft = container.querySelector(".slide-nav-left");
  const navRight = container.querySelector(".slide-nav-right");

  let currentSlide = 0;
  let autoSyncEnabled = syncWithAudio;

  function updateSlide() {
    const slide = resolvedSlides[currentSlide];
    img.src = slide.url;
    img.alt = `Slide ${currentSlide + 1}`;

    // Don't set opacity here - let hover handlers manage it
    // Just ensure the arrows can be shown/hidden based on position
    if (currentSlide === 0) {
      navLeft.setAttribute("data-disabled", "true");
    } else {
      navLeft.removeAttribute("data-disabled");
    }

    if (currentSlide === totalSlides - 1) {
      navRight.setAttribute("data-disabled", "true");
    } else {
      navRight.removeAttribute("data-disabled");
    }
  }

  function goToSlide(index, fromAudioSync = false) {
    currentSlide = Math.max(0, Math.min(index, totalSlides - 1));
    updateSlide();

    // If user manually navigates, disable auto-sync temporarily
    if (!fromAudioSync && autoSyncEnabled) {
      autoSyncEnabled = false;
      // Re-enable after a delay
      setTimeout(() => {
        autoSyncEnabled = syncWithAudio;
      }, 3000);
    }
  }

  // Binary search to find the slide index for a given time
  function findSlideIndexAtTime(time) {
    // Find the last slide whose timestamp is <= current time
    let result = 0;
    for (let i = 0; i < resolvedSlides.length; i++) {
      if (resolvedSlides[i].timestamp !== undefined && resolvedSlides[i].timestamp <= time) {
        result = i;
      } else {
        break;
      }
    }
    return result;
  }

  // Click handling with zones
  slideContainer.addEventListener("click", (evt) => {
    const rect = slideContainer.getBoundingClientRect();
    const clickX = evt.clientX - rect.left;
    const width = rect.width;

    // Left third goes back, right two-thirds advances
    if (clickX < width / 3) {
      goToSlide(currentSlide - 1);
    } else {
      goToSlide(currentSlide + 1);
    }
  });

  // Keyboard events
  container.addEventListener("keydown", (evt) => {
    if (evt.key === "ArrowRight" || evt.key === " ") {
      evt.preventDefault();
      goToSlide(currentSlide + 1);
    } else if (evt.key === "ArrowLeft") {
      evt.preventDefault();
      goToSlide(currentSlide - 1);
    } else if (evt.key === "Home") {
      evt.preventDefault();
      goToSlide(0);
    } else if (evt.key === "End") {
      evt.preventDefault();
      goToSlide(totalSlides - 1);
    }
  });

  // Initialize arrow visibility
  updateSlide();

  // Handle hover to show/hide arrows based on zone
  navLeft.addEventListener("mouseenter", () => {
    if (!navLeft.hasAttribute("data-disabled")) {
      navLeft.style.opacity = "0.7";
    }
  });

  navLeft.addEventListener("mouseleave", () => {
    navLeft.style.opacity = "0";
  });

  navRight.addEventListener("mouseenter", () => {
    if (!navRight.hasAttribute("data-disabled")) {
      navRight.style.opacity = "0.7";
    }
  });

  navRight.addEventListener("mouseleave", () => {
    navRight.style.opacity = "0";
  });

  // Audio sync setup - defer until DOM is ready to ensure audio element exists
  function setupAudioSync() {
    if (syncWithAudio && audioPlayerId) {
      const audioPlayerContainer = document.getElementById(audioPlayerId);
      if (audioPlayerContainer) {
        const audio = audioPlayerContainer.querySelector("audio");
        if (audio) {
          // Sync slides with audio playback
          audio.addEventListener("timeupdate", () => {
            if (!autoSyncEnabled) return;

            const time = audio.currentTime;
            const targetSlide = findSlideIndexAtTime(time);

            if (targetSlide !== currentSlide) {
              goToSlide(targetSlide, true);
            }
          });

          // Also sync on seeking
          audio.addEventListener("seeked", () => {
            if (!autoSyncEnabled) return;

            const time = audio.currentTime;
            const targetSlide = findSlideIndexAtTime(time);
            goToSlide(targetSlide, true);
          });
        }
      }
    }
  }

  // Wait for DOM to be fully loaded before setting up audio sync
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAudioSync);
  } else {
    // DOM is already loaded, setup immediately
    setupAudioSync();
  }
</script>

<style>
  .talk-slides {
    max-width: 100%;
  }
</style>
