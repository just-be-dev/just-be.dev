---
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

interface Tab {
  href: string;
  keyChar: string;
  label: string;
}

const tabs: Tab[] = [
  { href: "/", keyChar: "h", label: "home" },
  { href: "/blog", keyChar: "b", label: "blog" },
  { href: "/projects", keyChar: "p", label: "projects" },
  { href: "/research", keyChar: "r", label: "research" },
  { href: "/work", keyChar: "w", label: "work" },
];

function isActive(href: string, path: string) {
  return href === "/" ? path === "/" : path.startsWith(href);
}

function highlightLabel(label: string, keyChar: string) {
  const index = label.toLowerCase().indexOf(keyChar.toLowerCase());
  if (index === -1) return { before: label, key: "", after: "" };
  return {
    before: label.slice(0, index),
    key: label.slice(index, index + 1),
    after: label.slice(index + 1),
  };
}
---

<a
  href="#main-content"
  class="skip-link absolute left-[-9999px] focus:left-0 top-lh bg-1 px-1 py-1 z-50 transition-filter"
>
  Skip to main content
</a>

<nav
  class="fixed top-0 left-0 right-0 flex items-center bg-1 z-10 h-lh justify-between lg:justify-start"
>
  <div class="flex">
    {
      tabs.map((tab) => {
        const active = isActive(tab.href, currentPath);
        const highlighted = highlightLabel(tab.label, tab.keyChar);
        return (
          <a
            href={tab.href}
            data-key={tab.keyChar}
            class:list={[
              "nav-link bg-1 px-1 flex items-center transition-filter",
              { active },
            ]}
            tabindex={active ? -1 : undefined}
          >
            {highlighted.before}
            <span class="font-bold underline">{highlighted.key}</span>
            {highlighted.after}
          </a>
        );
      })
    }
  </div>

  <div
    class="flex items-center h-lh lg:fixed lg:left-1/2 lg:-translate-x-1/2 lg:z-20"
  >
    <span class="text-fg-0 font-normal flex gap-1">
      <span>
        <span class="font-bold">just</span><span
          class="font-normal text-fg-1 max-md:hidden">in</span
        >
      </span>
      <span>
        <span class="font-bold">be</span><span
          class="font-normal text-fg-1 max-md:hidden">nnett</span
        >
      </span>
    </span>
  </div>

  <div class="flex h-lh pr-1 lg:ml-auto">
    <a
      href="mailto:contact@just-be.dev"
      class="icon-link"
      title="Email"
      aria-label="Email"
    >
      <Icon name="pixel:envelope-solid" />
    </a>
    <a
      href="https://github.com/just-be-dev"
      target="_blank"
      rel="noopener noreferrer"
      class="icon-link"
      title="GitHub"
      aria-label="GitHub"
    >
      <Icon name="pixel:github" />
    </a>
    <a
      href="https://bsky.app/profile/just-be.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="icon-link"
      title="Bluesky"
      aria-label="Bluesky"
    >
      <Icon name="pixel:bluesky" />
    </a>
    <a
      href="https://twitter.com/just_be_dev"
      target="_blank"
      rel="noopener noreferrer"
      class="icon-link"
      title="Twitter"
      aria-label="Twitter"
    >
      <Icon name="pixel:twitter" />
    </a>
    <a
      href="https://linkedin.com/in/jtbnnt"
      target="_blank"
      rel="noopener noreferrer"
      class="icon-link"
      title="LinkedIn"
      aria-label="LinkedIn"
    >
      <Icon name="pixel:linkedin" />
    </a>
  </div>
</nav>

<style>
  .nav-link {
    display: flex;
    align-items: center;
    transition: filter 0.2s;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    filter: invert(1);
    outline: none;
  }

  .nav-link.active,
  .nav-link.active:hover,
  .nav-link.active:focus-visible {
    background-color: var(--background0);
    color: var(--foreground0);
    filter: invert(0);
    outline: none;
    pointer-events: none;
    cursor: default;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--background1);
    height: 100%;
    padding: 0.5rem;
    transition: filter 0.2s;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    filter: invert(1);
    outline: none;
  }

  .skip-link {
    transition: filter 0.2s;
  }

  .skip-link:focus {
    filter: invert(1);
    outline: none;
  }
</style>
