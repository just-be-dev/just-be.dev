---
import type { ProjectState } from "@/utils/desk";

interface Props {
  /** A Desk project state, or "experimental" for the experimental badge. */
  status: ProjectState | "experimental";
}

const { status } = Astro.props;

const statusColors: Record<Props["status"], string> = {
  idea: "bg-cyan-500/20 text-cyan-700 dark:text-cyan-300",
  active: "bg-green-500/20 text-green-700 dark:text-green-300",
  maintenance: "bg-yellow-500/20 text-yellow-700 dark:text-yellow-300",
  done: "bg-blue-500/20 text-blue-700 dark:text-blue-300",
  archived: "bg-gray-500/20 text-gray-700 dark:text-gray-400",
  experimental: "bg-purple-500/20 text-purple-700 dark:text-purple-300",
};

const statusColor = statusColors[status] || "bg-1 text-fg-1";
---

<span class={`px-1 whitespace-nowrap ${statusColor}`}>
  {status}
</span>
