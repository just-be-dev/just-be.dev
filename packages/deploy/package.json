{
  "name": "@just-be/deploy",
  "version": "0.11.0",
  "description": "Deploy static sites to Cloudflare R2 with subdomain routing",
  "keywords": [
    "cloudflare",
    "deploy",
    "r2",
    "static-site"
  ],
  "license": "MIT",
  "author": "Justin Bennett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-be-dev/just-be.dev.git",
    "directory": "packages/deploy"
  },
  "bin": {
    "deploy": "index.ts"
  },
  "files": [
    "index.ts",
    "schema.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate-schema": "bun run scripts/generate-schema.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@just-be/wildcard": "workspace:*",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
