{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "static"
              },
              "spa": {
                "type": "boolean"
              },
              "fallback": {
                "type": "string"
              },
              "redirects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\/.*"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "permanent": {
                      "type": "boolean"
                    }
                  },
                  "required": ["path", "url"],
                  "additionalProperties": false
                }
              },
              "rewrites": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\/.*"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "allowedMethods": {
                      "default": ["GET", "HEAD", "OPTIONS"],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
                      }
                    }
                  },
                  "required": ["path", "url", "allowedMethods"],
                  "additionalProperties": false
                }
              },
              "subdomain": {
                "type": "string"
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "description": "Name of the Cloudflare Worker secret containing the password for HTTP Basic Auth protection"
              }
            },
            "required": ["type", "subdomain", "dir"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "redirect"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "permanent": {
                "type": "boolean"
              },
              "preservePath": {
                "type": "boolean"
              },
              "subdomain": {
                "type": "string"
              },
              "password": {
                "type": "string",
                "description": "Name of the Cloudflare Worker secret containing the password for HTTP Basic Auth protection"
              }
            },
            "required": ["type", "url", "subdomain"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "rewrite"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "allowedMethods": {
                "default": ["GET", "HEAD", "OPTIONS"],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
                }
              },
              "subdomain": {
                "type": "string"
              },
              "password": {
                "type": "string",
                "description": "Name of the Cloudflare Worker secret containing the password for HTTP Basic Auth protection"
              }
            },
            "required": ["type", "url", "allowedMethods", "subdomain"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["rules"],
  "additionalProperties": false,
  "title": "Deploy Configuration",
  "description": "Configuration for deploying static sites and setting up routing for the wildcard subdomain service"
}
